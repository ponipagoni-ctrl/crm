rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Администратор CRM (тот же email, что в js/firebase-config.js)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ponipagoni@gmail.com';
    }

    // Одобренный сотрудник (или администратор)
    function isApproved() {
      return request.auth != null && (
        isAdmin()
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true
      );
    }

    // Анкеты пользователей: создать может любой вошедший (только со статусом
    // «не одобрен»), одобряет/отключает — только администратор
    match /users/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create: if isAdmin()
        || (request.auth != null && request.auth.uid == uid
            && request.resource.data.approved == false);
      allow update, delete: if isAdmin();
    }

    // Данные CRM — только для одобренной команды
    match /clients/{id}   { allow read, write: if isApproved(); }
    match /deals/{id}     { allow read, write: if isApproved(); }
    match /campaigns/{id} { allow read, write: if isApproved(); }
    match /tasks/{id}     { allow read, write: if isApproved(); }
    match /meta/{id}      { allow read, write: if isApproved(); }
    // Лиды кладёт программа поиска (сервисный аккаунт, правила её не касаются);
    // команда их читает и меняет статус, создавать вручную не нужно
    match /leads/{id}     { allow read, update, delete: if isApproved(); }

    // Приложение исполнителей «Аниматор Про» (вход по PIN, в базу ходит
    // анонимно). Список исполнителей и назначения доступны любому вошедшему —
    // включая анонимный вход приложения и команду CRM.
    match /performers/{id}  { allow read, write: if request.auth != null; }
    match /assignments/{id} { allow read, write: if request.auth != null; }

    // Калькулятор: учёт «Показал цену» / «Забронировать» без персональных данных.
    // Посетитель сайта может только ДОБАВИТЬ запись строго заданного вида;
    // читать и удалять — только команда CRM.
    match /calc_events/{id} {
      allow read, delete: if isApproved();
      allow update: if false;
      allow create: if request.resource.data.keys().hasOnly(
            ['type','pair','fmt','period','slot','zone','total','from','visit','at'])
        && request.resource.data.type in ['price_shown', 'book_click', 'book_call', 'book_max', 'book_tg', 'kp_request']
        && request.resource.data.pair is string   && request.resource.data.pair.size() <= 40
        && request.resource.data.fmt is string    && request.resource.data.fmt.size() <= 40
        && request.resource.data.period is string && request.resource.data.period.size() <= 40
        && request.resource.data.slot is string   && request.resource.data.slot.size() <= 40
        && request.resource.data.zone is string   && request.resource.data.zone.size() <= 40
        && request.resource.data.from is string   && request.resource.data.from.size() <= 40
        && request.resource.data.visit is string  && request.resource.data.visit.size() <= 40
        && request.resource.data.total is int
        && request.resource.data.total >= 0 && request.resource.data.total < 1000000
        && request.resource.data.at is timestamp
        && request.resource.data.at > request.time - duration.value(1, 'h')
        && request.resource.data.at < request.time + duration.value(1, 'h');
    }
  }
}
